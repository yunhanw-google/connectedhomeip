<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

  <com.google.android.material.appbar.AppBarLayout
      android:id="@+id/appBarLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/transparent"
      app:elevation="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Matter Device Hub"
        app:titleCentered="false" />

    <!-- Search Bar with Voice Assist action -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:hint="Search rooms, devices, aliases..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/voiceSearchBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Voice Command (Gemini Nano)" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Horizontal Room Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

      <com.google.android.material.chip.ChipGroup
          android:id="@+id/roomChipGroup"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:singleSelection="true"
          app:selectionRequired="false" />
    </HorizontalScrollView>
  </com.google.android.material.appbar.AppBarLayout>

  <!-- Nested Room & Device Hierarchy RecyclerView -->
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/roomHierarchyRecyclerView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:paddingBottom="88dp"
      app:layout_behavior="@string/appbar_scrolling_view_behavior"
      tools:listitem="@layout/item_room_section" />

  <!-- Empty State View when NO devices are commissioned -->
  <LinearLayout
      android:id="@+id/emptyStateLayout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:gravity="center"
      android:padding="24dp"
      android:visibility="gone"
      app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/emptyStateCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorOutlineVariant">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:gravity="center"
          android:padding="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_dialog_info"
            android:contentDescription="No devices" />

        <TextView
            android:id="@+id/emptyStateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No Matter devices commissioned yet"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/colorOnSurface" />

        <TextView
            android:id="@+id/emptyStateSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Commission a device to get started or explore demo devices."
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

          <com.google.android.material.button.MaterialButton
              android:id="@+id/commissionDeviceBtn"
              style="@style/Widget.MaterialComponents.Button"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Commission Device" />

          <com.google.android.material.button.MaterialButton
              android:id="@+id/loadDemoDevicesBtn"
              style="@style/Widget.MaterialComponents.Button.OutlinedButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:text="Load Demo Devices" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>

  <!-- FAB for Dynamic Voice AI & Commissioning -->
  <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
      android:id="@+id/voiceAiFab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_margin="16dp"
      android:text="Voice Control"
      app:icon="@android:drawable/ic_btn_speak_now" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
