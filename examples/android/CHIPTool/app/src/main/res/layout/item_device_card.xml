<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deviceCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <!-- Header: Icon, Titles & Main Switch/Lock Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <ImageView
          android:id="@+id/deviceIcon"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:src="@android:drawable/ic_dialog_info"
          android:background="?attr/colorSurfaceVariant"
          android:padding="8dp"
          android:contentDescription="Device Icon" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="12dp"
          android:layout_marginEnd="8dp"
          android:orientation="vertical">

        <TextView
            android:id="@+id/deviceLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Living Room Ceiling Light"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/deviceSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Matter Smart Color Bulb • Node 0x1001"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
      </LinearLayout>

      <!-- Inline Toggle Switch (for On/Off) -->
      <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/quickToggleSwitch"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:visibility="visible" />

      <!-- Inline Lock/Unlock Button (for DoorLock) -->
      <com.google.android.material.button.MaterialButton
          android:id="@+id/quickLockButton"
          style="@style/Widget.Material3.Button.TonalButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Lock"
          android:visibility="gone" />
    </LinearLayout>

    <!-- Inline Slider (for Brightness / Level / Shutter Lift) -->
    <LinearLayout
        android:id="@+id/sliderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:visibility="visible">

      <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:src="@android:drawable/ic_menu_crop"
          android:contentDescription="Brightness" />

      <com.google.android.material.slider.Slider
          android:id="@+id/quickLevelSlider"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:valueFrom="0"
          android:valueTo="100"
          android:value="75"
          android:stepSize="1" />

      <TextView
          android:id="@+id/sliderValueText"
          android:layout_width="40dp"
          android:layout_height="wrap_content"
          android:gravity="end"
          android:text="75%"
          android:textSize="12sp"
          android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Telemetry Badges Flow -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/deviceBadgeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

      <com.google.android.material.chip.Chip
          android:id="@+id/badgeOnline"
          style="@style/Widget.Material3.Chip.Assist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Online"
          app:chipIcon="@android:drawable/presence_online" />

      <com.google.android.material.chip.Chip
          android:id="@+id/badgeBattery"
          style="@style/Widget.Material3.Chip.Assist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="95%" />

      <com.google.android.material.chip.Chip
          android:id="@+id/badgeState"
          style="@style/Widget.Material3.Chip.Assist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="ON" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Semantic Voice Aliases Display -->
    <TextView
        android:id="@+id/aliasesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Voice Aliases: lamp, overhead light, main light"
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="?attr/colorPrimary" />

    <!-- Card Action Footer: Edit Aliases & Inspect Endpoints -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

      <com.google.android.material.button.MaterialButton
          android:id="@+id/editAliasesButton"
          style="@style/Widget.Material3.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Edit Room/Aliases"
          android:textSize="12sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/inspectEndpointsButton"
          style="@style/Widget.Material3.Button.TonalButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="Inspect (EP 0..N)"
          android:textSize="12sp"
          app:icon="@android:drawable/ic_menu_more" />
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
